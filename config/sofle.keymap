#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define QWERTY 0
#define RAISE  1
#define LOWER  2

#define TMUX_PREFIX LC(M)

/ {
    macros {
        tmx_wn: tmx_window_next {
            label = "tmx_window_next";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp TMUX_PREFIX>, <&kp U>;
        };
        tmx_wp: tmx_window_prev {
            label = "tmx_window_prev";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp TMUX_PREFIX>, <&kp Y>;
        };
        tmx_pn: tmx_pane_next {
            label = "tmx_pane_next";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp TMUX_PREFIX>, <&kp I>;
        };
        tmx_pp: tmx_pane_prev {
            label = "tmx_pane_prev";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp TMUX_PREFIX>, <&kp H>;
        };
        tmx_zoom: tmx_zoom {
            label = "tmx_zoom";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp TMUX_PREFIX>, <&kp Z>;
        };
        tmx_copy: tmx_copy {
            label = "tmx_copy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp TMUX_PREFIX>, <&kp LBKT>;
        };
    };

    behaviors {
        enc_win: encoder_window {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&tmx_wn>, <&tmx_wp>;
        };
        enc_pane: encoder_pane {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&tmx_pn>, <&tmx_pp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            label = "QWERTY";
            bindings = <
/* ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮                     ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮ */
   &kp GRAVE   &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                            &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSLH
/* ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤                     ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤ */
   &kp ESC    &kp Q      &kp W      &kp E      &kp R      &kp T                             &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSPC
/* ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤                     ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤ */
   &kp LSHFT  &kp A      &kp S      &kp D      &kp F      &kp G                             &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
/* ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────╮ ╭──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤ */
   &kp TAB    &kp Z      &kp X      &kp C      &kp V      &kp B      &tmx_zoom    &tmx_copy  &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
/* ╰──────────┴──────────┼──────────┼──────────┼──────────┼──────────┼──────────╯ ╰──────────┼──────────┼──────────┼──────────┼──────────┼──────────╯ */
                          &kp LCTRL  &kp LALT   &kp LGUI   &kp SPACE  &mo LOWER    &mo RAISE  &kp ENTER  &kp RGUI   &kp RALT   &kp RCTRL
/* ╰──────────┴──────────┴──────────┴──────────╯                                              ╰──────────┴──────────┴──────────╯ */
            >;

            sensor-bindings = <&enc_win>, <&enc_pane>;
        };

        raise_layer {
            label = "RAISE";
            bindings = <
/* ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮                     ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮ */
   &kp F12    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5                            &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11
/* ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤                     ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤ */
   &trans     &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT                         &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp DEL
/* ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤                     ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤ */
   &trans     &kp TILDE  &kp GRAVE  &kp LBRC   &kp RBRC   &kp PIPE                          &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp MINUS  &kp EQUAL
/* ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────╮ ╭──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤ */
   &trans     &to 0      &trans     &kp LBKT   &kp RBKT   &kp BSLH   &trans        &trans    &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp UNDER  &kp PLUS
/* ╰──────────┴──────────┼──────────┼──────────┼──────────┼──────────┼──────────╯ ╰──────────┼──────────┼──────────┼──────────┼──────────┼──────────╯ */
                          &trans     &trans     &trans     &trans     &trans        &trans     &trans     &trans     &trans     &trans
/* ╰──────────┴──────────┴──────────┴──────────╯                                              ╰──────────┴──────────┴──────────╯ */
            >;

            sensor-bindings = <&enc_win>, <&enc_pane>;
        };

        lower_layer {
            label = "LOWER";
            bindings = <
/* ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮                     ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮ */
/* Brightness                                                                               Media                                                              */
   &trans     &kp C_BRI_DN &kp C_BRI_UP &trans  &trans    &trans                            &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PP  &trans    &trans
/* ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤                     ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤ */
/* Numpad row 1                                                                             Numpad row 1 cont.                                                 */
   &trans     &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                            &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
/* ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤                     ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤ */
/* Numpad-style symbols                                                                                                                                        */
   &trans     &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT                         &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp EQUAL
/* ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────╮ ╭──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤ */
   &trans     &trans     &trans     &kp MINUS  &kp PLUS   &kp EQUAL  &trans        &trans    &kp UNDER  &kp LBKT   &kp RBKT   &kp LBRC   &kp RBRC   &trans
/* ╰──────────┴──────────┼──────────┼──────────┼──────────┼──────────┼──────────╯ ╰──────────┼──────────┼──────────┼──────────┼──────────┼──────────╯ */
                          &trans     &trans     &trans     &trans     &trans        &trans     &trans     &trans     &trans     &trans
/* ╰──────────┴──────────┴──────────┴──────────╯                                              ╰──────────┴──────────┴──────────╯ */
            >;

            sensor-bindings = <&enc_win>, <&enc_pane>;
        };
    };
};
